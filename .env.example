# Database (PostgreSQL via Railway or other provider)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Resend (email)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="SACNS Auction <auction@yourdomain.com>"

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Stripe (optional — card checkout disabled unless below is "true")
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxx"
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
NEXT_PUBLIC_CARD_CHECKOUT_ENABLED="false"

# Winner payments: Venmo username (no @). Shown on item page when set.
NEXT_PUBLIC_VENMO_HANDLE="YourVenmoUsername"
# Optional override for "email us for Venmo" fallback
# NEXT_PUBLIC_PAYMENT_CONTACT_EMAIL="treasurer@example.com"
